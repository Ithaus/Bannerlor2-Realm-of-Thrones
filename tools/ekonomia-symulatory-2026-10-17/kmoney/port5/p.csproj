<Project Sdk="Microsoft.NET.Sdk">
  <!-- port5 (r4-kupcy H8): rdzen KsFoodCore z repo (sciezki wzgledne) + Program.cs; NEWCORE = flagi rundy 4 (bez NEWCORE - wzorzec starej wersji) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);NEWCORE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../../../Armoury/src/KsFoodCore.cs" />
    <Compile Include="../../../../Armoury/src/StartCalibration.Tables.cs" />
    <Compile Include="../../../../Armoury/src/StartCalibration.Core.cs" />
    <Compile Include="../../../../Armoury/src/StartCalibration.Deliver.cs" />
    <Compile Include="../../../../Armoury/src/StartCalibration.Corridors.cs" />
    <!-- recenzja ceny-r5: Core.cs potrzebuje Feed.cs i KsCheap.cs (od scalenia nocy 17/18.10) -->
    <Compile Include="../../../../Armoury/src/StartCalibration.Feed.cs" />
    <Compile Include="../../../../Armoury/src/KsCheap.cs" />
  </ItemGroup>
</Project>
