<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <Prefer32Bit>false</Prefer32Bit>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <!-- rdzen naprawy kompilowany prosto z CrashScribe - uprzaz testuje dokladnie ten kod, ktory idzie do gry -->
    <CoreSrc Condition="'$(CoreSrc)' == ''">..\..\CrashScribe\src\UnwindCore.cs</CoreSrc>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(CoreSrc)" Link="UnwindCore.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>lib\0Harmony.dll</HintPath><Private>true</Private></Reference>
    <None Include="lib\*.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
