<?xml version="1.0" encoding="utf-8"?>
<!-- CrashScribe - the record keeper. Reports land in:
     Documents\Mount and Blade II Bannerlord\CrashScribe\session-<date>.log
     Changes take effect after a game restart. -->
<CrashScribe>
  <!-- errors that would otherwise take the game down with them -->
  <CatchUnhandled>true</CatchUnhandled>

  <!-- errors caught somewhere further up the call chain - very often the real cause,
       because a swallowed error leaves broken state behind and the crash comes later -->
  <CatchFirstChance>true</CatchFirstChance>
  <!-- ...but only report those with a mod in the stack, or the log drowns in engine noise -->
  <OnlyModdedFirstChance>true</OnlyModdedFirstChance>

  <!-- a Harmony net over every method of the listed mods -->
  <WrapModMethods>true</WrapModMethods>
  <!-- caught an error inside one of our mods: write it down and carry on instead of a crash to desktop.
       Set to false if you would rather the game die loudly at the exact spot. -->
  <SwallowModErrors>true</SwallowModErrors>
  <!-- leave empty to net every non-native mod; that is thorough but slows startup a good deal -->
  <WrapModules>RealisticCaptivity,GrandTourney,Armoury</WrapModules>

  <!-- extra watch over the game's own tournament code - logged, never swallowed -->
  <WrapCampaignHotspots>true</WrapCampaignHotspots>

  <!-- a short red note on screen when something goes wrong, so you know to look at the log -->
  <ShowInGame>true</ShowInGame>

  <MaxReportsPerSession>300</MaxReportsPerSession>
  <KeepSessions>15</KeepSessions>

  <!-- The Night King's Call: the Others' bands pool their wights into the strongest band until it
       reaches ROT's siege threshold (500 healthy), and the horde's party size bonus is kept so that
       band sits at NightKingCallFullness of its limit (ROT besieges at 80%+). Everything else -
       targets, 2.5x odds, AI shackles, the invasion after all 25 settlements beyond the Wall -
       stays in ROT's hands. Set NightKingCallEnabled to false to switch it off. -->
  <NightKingCallEnabled>true</NightKingCallEnabled>
  <NightKingCallTarget>520</NightKingCallTarget>
  <NightKingCallKeep>40</NightKingCallKeep>
  <NightKingCallKeepNk>120</NightKingCallKeepNk>
  <NightKingCallFullness>0.85</NightKingCallFullness>

  <!-- The Night King's March: once the strongest band of the Others has NightKingMarchMin healthy
       wights, it is handed a target of its own - a fortification beyond the Wall that is not theirs,
       that they are at war with, and whose garrison plus militia they outnumber at least
       NightKingMarchOdds to one; of those, the weakest, and the nearest of equals. Realm of Thrones
       only ever orders a siege at 2.5 to one and has not found a single target in 193 days, while
       every other order it writes for the Others is silently dropped because their clan has no
       kingdom - so without this the horde simply stands. The order is given only when the band has
       no siege order of its own; from then on Realm of Thrones keeps that target itself. The Wall is
       left alone, and once ROT's invasion flag turns on this stops interfering altogether.
       Set NightKingMarchEnabled to false to switch it off. -->
  <NightKingMarchEnabled>true</NightKingMarchEnabled>
  <NightKingMarchMin>500</NightKingMarchMin>
  <NightKingMarchOdds>2.0</NightKingMarchOdds>
  <NightKingMarchRespectCooldown>true</NightKingMarchRespectCooldown>
  <!-- list every fortification beyond the Wall once a day with its garrison, odds, distance and war state -->
  <NightKingMarchVerbose>true</NightKingMarchVerbose>

  <!-- The Others' calendar: in the books the dead win battles beyond the Wall for years before they hold
       anything. Before a settlement's day (counted from the start of the campaign) the Night King's March
       will not pick it, a band of the Others already ordered to besiege it is sent to patrol around its
       clan's seat instead, and the Night King's Call sleeps until NightKingCallFromDay.
       Fist of the First Men, Craster's Keep and every other target: NightKingSiegeFromDay (728 = start of year 3).
       With NightKingRespectShackles, Realm of Thrones' own AI shackles apply on top, stretched by FabulaTimeScale:
       Hornfoot and Frozen Shore 300 x 4.33 = 1299, Thenn and Frostfang's Camp 1732, Hardhome 2165
       (only while "Others AI shackles" is on in Realm of Thrones' own settings; off there = day 728 for these too).
       The Wall: NightKingWallFromDay (2184 = start of year 7). Settlements the Others already hold are never
       taken away. Set NightKingCalendarEnabled to false to switch the whole calendar off. -->
  <NightKingCalendarEnabled>true</NightKingCalendarEnabled>
  <NightKingSiegeFromDay>728</NightKingSiegeFromDay>
  <NightKingRespectShackles>true</NightKingRespectShackles>
  <NightKingWallFromDay>2184</NightKingWallFromDay>
  <NightKingCallFromDay>728</NightKingCallFromDay>

  <!-- The Others grow only from the dead: in the books the wights are the fallen and the captives of the
       Others, raised again - nobody hands the Night King an army out of thin air. Realm of Thrones does:
       every new band of the Others gets 100 extra wights at birth (on top of its 53-man template), every
       band gets 2 more wights each day until it is full, and the base game lets them pick up 3-7 "volunteers
       from the map" now and then, like any minor faction outside a settlement. With OthersNoFreeGrowth on,
       those three sources are shut: OthersNoBirthDowry (the +100 at birth), OthersNoDailyWights (the +2 a day)
       and OthersNoMapVolunteers (volunteers from the map). Raising the dead after a battle and freed prisoners
       are left exactly as Realm of Thrones has them. A new band still starts with its template and its leader.
       Bands already in the field keep their men. Set OthersNoFreeGrowth to false to switch all of it off.
       OthersStartDowryDays: the old dead the Others already have when the story begins - during the first N
       days of a new campaign the +100 at birth is still given (the first 4 bands start at about 154 each,
       616 in all), so the Night King's call and march have something to start from. 0 = no exception.
       In a campaign older than N days it does nothing. -->
  <OthersNoFreeGrowth>true</OthersNoFreeGrowth>
  <OthersNoBirthDowry>true</OthersNoBirthDowry>
  <OthersStartDowryDays>2</OthersStartDowryDays>
  <OthersNoDailyWights>true</OthersNoDailyWights>
  <OthersNoMapVolunteers>true</OthersNoMapVolunteers>

  <!-- Siege camps do not rot while fed: RealisticBannerlord's SiegeAttritionBehavior kills 2-5 men
       of every besieging party each day (escalating) regardless of food and morale. With this on,
       the camp only suffers those losses while it is STARVING, and a besieged garrison only while
       the town has no food stocks. Set to false to restore RealisticBannerlord's daily attrition. -->
  <RbSiegeAttritionOnlyStarving>true</RbSiegeAttritionOnlyStarving>
</CrashScribe>
