<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Armoury</AssemblyName>
    <RootNamespace>Armoury</RootNamespace>
    <Configuration>Release</Configuration>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Wioski na mapie (W2): SandBox.dll i SandBox.View.dll (komponent widoku mapy dziedziczy po typach SandBox.View - refleksja
         nie wystarczy). Z libs/, a gdy ich tam nie ma - wprost z katalogu modulu SandBox gry (patrz libs/README.md). -->
    <SandBoxLibs Condition="'$(SandBoxLibs)' == '' And Exists('$(GameLibs)/SandBox.View.dll')">$(GameLibs)</SandBoxLibs>
    <SandBoxLibs Condition="'$(SandBoxLibs)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Mount &amp; Blade II Bannerlord/Modules/SandBox/bin/Win64_Shipping_Client</SandBoxLibs>
    <!-- sw-herby (noc 17/18.10): proporczyki wiosek na wlasnych teksturach herbow (BannerTextureCreationData, ThumbnailCacheManager) - TaleWorlds.MountAndBlade.View.dll
         z modulu Native gry. Z libs/, a gdy jej tam nie ma - wprost z katalogu modulu Native gry (jak SandBox wyzej). -->
    <NativeViewLibs Condition="'$(NativeViewLibs)' == '' And Exists('$(GameLibs)/TaleWorlds.MountAndBlade.View.dll')">$(GameLibs)</NativeViewLibs>
    <NativeViewLibs Condition="'$(NativeViewLibs)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Mount &amp; Blade II Bannerlord/Modules/Native/bin/Win64_Shipping_Client</NativeViewLibs>
    <!-- m103-sceny (E4, 21.10): okna opowiesci w wygladzie wydarzen ROT (ArmStoryEvent dziedziczy po ROT.Events.EventBase - ROT.dll z ROT-Core) i obrazki z plikow
         PNG/JPG jako sprite'y Gauntlet (StoryPictures: TaleWorlds.TwoDimension.Sprite, Texture, SpriteData - TaleWorlds.TwoDimension.dll z bin gry). Z libs/, a gdy
         ich tam nie ma - wprost z katalogow gry (jak SandBox i Native wyzej; kopii w libs nie robic - dysk C zeruje pliki). Private=false: gra laduje oba zestawy sama. -->
    <RotLibs Condition="'$(RotLibs)' == '' And Exists('$(GameLibs)/ROT.dll')">$(GameLibs)</RotLibs>
    <RotLibs Condition="'$(RotLibs)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Mount &amp; Blade II Bannerlord/Modules/ROT-Core/bin/Win64_Shipping_Client</RotLibs>
    <TwoDimLibs Condition="'$(TwoDimLibs)' == '' And Exists('$(GameLibs)/TaleWorlds.TwoDimension.dll')">$(GameLibs)</TwoDimLibs>
    <TwoDimLibs Condition="'$(TwoDimLibs)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Mount &amp; Blade II Bannerlord/bin/Win64_Shipping_Client</TwoDimLibs>
    <!-- 155: pasek staminy konia w HUD bitwy (HorseWindBarUi.cs - mixin MissionAgentStatusVM): TaleWorlds.MountAndBlade.ViewModelCollection.dll z bin gry.
         Z libs/, a gdy jej tam nie ma - wprost z katalogu bin gry (jak TwoDimLibs wyzej; recenzja 155: libs/*.dll poza repo, inne worktree jej nie maja). -->
    <MbVmLibs Condition="'$(MbVmLibs)' == '' And Exists('$(GameLibs)/TaleWorlds.MountAndBlade.ViewModelCollection.dll')">$(GameLibs)</MbVmLibs>
    <MbVmLibs Condition="'$(MbVmLibs)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Mount &amp; Blade II Bannerlord/bin/Win64_Shipping_Client</MbVmLibs>
  </PropertyGroup>
  <PropertyGroup Condition="'$(T10Dry)' == 'true'">
    <!-- T10 (uwaga krytyki 6): DLL "na sucho" do pierwszego autotestu - ksiega snu AI i powody nocnego marszu tylko w logu,
         zachowanie i kary jak w T1 (stala T10_DRY w NightMarch.cs). Budowanie: -p:T10Dry=true (najlepiej z osobnym
         -p:OutDir=... i potem zwykly build z -t:Rebuild, zeby obj nie zostal z wersja na sucho). -->
    <DefineConstants>$(DefineConstants);T10_DRY</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(W4Photo)' == 'true'">
    <!-- E7/W4 (237, projekt etapu 7 T2 "jesli spalonych 0"): DLL do zdjec - pierwsza wioska kazdego okregu pokazana na mapie jako spalona (sam widok:
         obrazek, dym, napis; ksiega wiosek i gra bez zmian). Stala W4_PHOTO w MapVillageLook.cs. Budowanie: -p:W4Photo=true z osobnym -p:OutDir=...,
         potem zwykly build z -t:Rebuild. NIE do wgrania Jeffowi. -->
    <DefineConstants>$(DefineConstants);W4_PHOTO</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="MCMv5"><HintPath>$(GameLibs)/MCMv5.dll</HintPath><Private>false</Private></Reference>
    <!-- f9-predkosc: przyciski biegu na pasku mapy (MapSpeedUi.cs - wstawka prefabu MapBar i mixin MapTimeControlVM); modul Bannerlord.UIExtenderEx laduje sie przed Armoury -->
    <Reference Include="Bannerlord.UIExtenderEx"><HintPath>$(GameLibs)/Bannerlord.UIExtenderEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameLibs)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.CampaignSystem"><HintPath>$(GameLibs)/TaleWorlds.CampaignSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Core"><HintPath>$(GameLibs)/TaleWorlds.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Library"><HintPath>$(GameLibs)/TaleWorlds.Library.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Localization"><HintPath>$(GameLibs)/TaleWorlds.Localization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.CampaignSystem.ViewModelCollection"><HintPath>$(GameLibs)/TaleWorlds.CampaignSystem.ViewModelCollection.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Core.ViewModelCollection"><HintPath>$(GameLibs)/TaleWorlds.Core.ViewModelCollection.dll</HintPath><Private>false</Private></Reference>
    <!-- 155: pasek staminy konia w HUD bitwy (HorseWindBarUi.cs - mixin MissionAgentStatusVM) - patrz MbVmLibs wyzej i libs/README.md -->
    <Reference Include="TaleWorlds.MountAndBlade.ViewModelCollection"><HintPath>$(MbVmLibs)/TaleWorlds.MountAndBlade.ViewModelCollection.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.InputSystem"><HintPath>$(GameLibs)/TaleWorlds.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.ObjectSystem"><HintPath>$(GameLibs)/TaleWorlds.ObjectSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.DotNet"><HintPath>$(GameLibs)/TaleWorlds.DotNet.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Engine"><HintPath>$(GameLibs)/TaleWorlds.Engine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.MountAndBlade"><HintPath>$(GameLibs)/TaleWorlds.MountAndBlade.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.SaveSystem"><HintPath>$(GameLibs)/TaleWorlds.SaveSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Engine"><HintPath>$(GameLibs)/TaleWorlds.Engine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.ScreenSystem"><HintPath>$(GameLibs)/TaleWorlds.ScreenSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.GauntletUI"><HintPath>$(GameLibs)/TaleWorlds.GauntletUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.GauntletUI.Data"><HintPath>$(GameLibs)/TaleWorlds.GauntletUI.Data.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Engine.GauntletUI"><HintPath>$(GameLibs)/TaleWorlds.Engine.GauntletUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Core.ViewModelCollection"><HintPath>$(GameLibs)/TaleWorlds.Core.ViewModelCollection.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.CampaignSystem.ViewModelCollection"><HintPath>$(GameLibs)/TaleWorlds.CampaignSystem.ViewModelCollection.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SandBox"><HintPath>$(SandBoxLibs)/SandBox.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SandBox.View"><HintPath>$(SandBoxLibs)/SandBox.View.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.MountAndBlade.View"><HintPath>$(NativeViewLibs)/TaleWorlds.MountAndBlade.View.dll</HintPath><Private>false</Private></Reference>
    <!-- m103-sceny: okno opowiesci ROT (ArmStoryEvent) i obrazki z plikow (StoryPictures) - patrz RotLibs / TwoDimLibs wyzej -->
    <Reference Include="ROT"><HintPath>$(RotLibs)/ROT.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.TwoDimension"><HintPath>$(TwoDimLibs)/TaleWorlds.TwoDimension.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
