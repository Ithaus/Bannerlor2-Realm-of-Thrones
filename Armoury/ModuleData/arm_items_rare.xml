<?xml version="1.0" encoding="utf-8"?>
<!-- m97-surowce (Armoury): rzadkie surowce lukow z czardrzewa i smoczej kosci. Kategoria arm_rare_stuff rejestruje kod (SubModuleMain.InitializeSubModuleGameObjects)
     przed wczytaniem tego pliku. Wartosc: ok. 2/3 ceny luku (HistExoticBows: weirwood_bow 6000, dragonbone_bow 20000) - reszta to praca mistrza. -->
<Items>
	<Item
		id="arm_weirwood"
		name="{=arm_weirwood}Weirwood{@Plural}weirwood staves{\@}"
		mesh="hardwood"
		culture="Culture.freefolk"
		item_category="arm_rare_stuff"
		value="4000"
		weight="2.5"
		Type="Goods">
		<Flags
			Civilian="true" />
	</Item>
	<Item
		id="arm_dragonbone"
		name="{=arm_dragonbone}Dragonbone{@Plural}pieces of dragonbone{\@}"
		mesh="walrus_ivory"
		culture="Culture.valyrian"
		item_category="arm_rare_stuff"
		value="14000"
		weight="2"
		Type="Goods">
		<Flags
			Civilian="true" />
	</Item>
	<!-- 563 (Jeff 15.11): sztaba stali valyrianskiej. Siatka istniejaca: klinga ROT val_steel_blade_blue (pack7.tpac; zapas: thamaskene_steel).
	     Kategoria arm_vs_stuff (RareMaterials.RegisterCategory, przed XML). 563c (Jeff: "1 jednostka wazy 0.5 kg"): sztaba = 0.5 kg stali
	     (ValyrianBlades.IngotG = 500 g - waga tu i w kodzie musza sie zgadzac, start sesji sprawdza). Wartosc = HistValyrianPerMeasure x 500 / 800
	     (miara = 0.8 kg, klinga VS Sword type 1; kod nadpisuje przy cenach historycznych). -->
	<Item
		id="arm_valyrian_steel"
		name="{=arm_valyrian_steel}Valyrian Steel{@Plural}ingots of Valyrian steel{\@}"
		mesh="val_steel_blade_blue"
		culture="Culture.valyrian"
		item_category="arm_vs_stuff"
		value="37500"
		weight="0.5"
		Type="Goods">
		<Flags
			Civilian="true" />
	</Item>
</Items>
