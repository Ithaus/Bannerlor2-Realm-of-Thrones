+                for (int i = 0; i < r.Count; i++)
+                {
+                    var el = r.GetElementCopyAtIndex(i);
+                    snap.El[i] = el.EquipmentElement; snap.N[i] = el.Amount;
+                    var it = el.EquipmentElement.Item;
